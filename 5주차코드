let planeX = 0;        
let planeY = 0;        
let lives = 5; 
let shakeTime = 0; 

let seaLevel = 320; // 바다 수면
let underwaterTimer = 0; // 물속에 빠져있는 시간
let waveOffset = 0;     
let isPaused = false; // false: 게임 진행 

let numObs = 5;          
let obsX = [];          
let obsY = [];           
let obsSpeed = [];       

let numClouds = 15;     
let cloudX = [];         
let cloudY = [];         


function setup() {
  createCanvas(700, 400); 
  
  for (let i = 0; i < numObs; i++) {       
    obsX[i] = random(700, 1200);  // 장애물을 화면 바깥에 설정
    obsY[i] = random(20, seaLevel - 30); // 장애물이 바다 안 쪽에 안 나오게 설정
    obsSpeed[i] = random(4, 8); // 장애물의 이동 속도 4~8 
  }

  for (let i = 0; i < numClouds; i++) {   
    cloudX[i] = random(0, 700);            
    cloudY[i] = random(20, seaLevel - 50); 
  }
}


function draw() {
  
  if (isPaused == false) { // false이면 아래 함수들을 실행
    drawSkyAndSea(); // 하늘과 바다 함수 호출
    drawPlane();// 비행기 함수 호출
    drawObstacles(); // 장애물 함수 호출
    checkCollision(); // 충돌 여부 함수 호출
    checkUnderwater(); // 물속에 있는지 확인하는 함수 호출
    drawLives(); // 목숨 함수 호출
  } 
  else {  // true이면 아래 코드를 실행 (화면 멈춤)
    fill(255);                 
    textSize(50);             
    textAlign(CENTER, CENTER); 
    text("일시정지", 350, 180);
  }
}


function drawSkyAndSea() {
  
  if (planeY > seaLevel) {  // 비행기가 바다보다 아래에 있다면
    background(255, 180, 180);     
  } else {                         
    background(135, 206, 235);    
  }

  fill(255);                      
  for (let i = 0; i < numClouds; i++) {    
    ellipse(cloudX[i], cloudY[i], 40, 20);   
    cloudX[i] = cloudX[i] - 2; // 왼쪽이동

    if (cloudX[i] < -10) {                  
      cloudX[i] = 700;                      
      cloudY[i] = random(20, seaLevel - 50); 
    }
  }
// 산 그리기 
  fill(34, 139, 34);     
  noStroke();                      
  triangle(-50, seaLevel, 100, 150, 300, seaLevel); 
  triangle(150, seaLevel, 350, 100, 550, seaLevel); 
  triangle(400, seaLevel, 600, 150, 800, seaLevel); 

  if (planeY > seaLevel) { // 비행기가 바다에 빠지면
    fill(255, 130, 130);  
  } else {                         
    fill(0, 105, 148);             
  }

  beginShape();                    
  vertex(0, 400);                 
  
  for (let x = 0; x <= 700; x = x + 10) {  
    let waveY = seaLevel + sin(x * 0.1 + waveOffset) * 10; // sin함수로 파도의 높낮이 값 계산
    vertex(x, waveY);  
  }
  
  vertex(700, 400);  // 마지막 꼭짓점을 도화지 오른쪽 맨 아래에 찍음
  endShape(CLOSE); 
  
  waveOffset = waveOffset + 0.05; // 매 프레임마다 파도 모양이 바뀌도록 변수 값을 0.05 증가
}


function drawPlane() {
 
  planeX = planeX + (mouseX - planeX) * 0.1; 
  planeY = planeY + (mouseY - planeY) * 0.1; 

  if (shakeTime > 0) { 
    planeX = planeX + random(-5, 5); 
    planeY = planeY + random(-5, 5); 
    shakeTime = shakeTime - 1; 
  }

  fill(200);   
  noStroke();  
  
  rect(planeX, planeY, 50, 15); 
  
  beginShape(); 
  vertex(planeX, planeY);              
  vertex(planeX, planeY - 20);          
  vertex(planeX + 15, planeY);          
  endShape(CLOSE); 
}


function drawObstacles() {
  for (let i = 0; i < numObs; i++) {     
    fill(255, 50, 50);                   
    stroke(255);                        
    strokeWeight(2);                     
    ellipse(obsX[i], obsY[i], 30, 30); 

    obsX[i] = obsX[i] - obsSpeed[i];    

    if (obsX[i] < -10) {                 
      obsX[i] = random(700, 900); 
      obsY[i] = random(0, seaLevel - 30); 
      obsSpeed[i] = random(5, 10);    
    }
  }
}

function checkCollision() {

  for (let i = 0; i < numObs; i++) { 
    let distance = dist(planeX, planeY, obsX[i], obsY[i]); 
    
    if (distance < 25) {         
      lives = lives - 1;          
      shakeTime = 30;             

      obsX[i] = random(700, 900); 
      obsY[i] = random(0, seaLevel - 30); 
    }
  }
}


function checkUnderwater() {
  if (planeY > seaLevel) {          
    
    underwaterTimer = underwaterTimer + 1; 
    
    if (underwaterTimer >= 300) { // 5초
      lives = lives - 1;  
      shakeTime = 30; 
      underwaterTimer = 0; // 타이머 초기화
    }

    let timeLeft = 5;                  
    if (underwaterTimer > 60)  { timeLeft = 4; } 
    if (underwaterTimer > 120) { timeLeft = 3; } 
    if (underwaterTimer > 180) { timeLeft = 2; } 
    if (underwaterTimer > 240) { timeLeft = 1; } 

    fill(255, 50, 50);             
    textSize(30);                      
    textAlign(CENTER, TOP);            
    text("빠져나오십시오!! " + timeLeft + " 초!", 350, 20); 
    
  } else {                             
    underwaterTimer = 0;               
  }
}


function drawLives() {
  fill(255, 255, 0);       
  noStroke();              
  textSize(20);            
  textAlign(LEFT, TOP);    
  text("목숨: " + lives, 20, 20); 
}


function keyPressed() {
  if (key === ' ') {  
    
    if (isPaused == false) { 
      isPaused = true;       
    } else {                 
      isPaused = false;     
    }
    
  }
}


